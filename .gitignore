*.pkl
!models/*.joblib
models/*.csv

# --- jupyter ---
.ipynb_checkpoints/

# --- editor/workbench artifacts (do not commit) ---
.virtual_documents/
anaconda_projects/

# --- local conda env export (use requirements.txt instead) ---
environment.yml
